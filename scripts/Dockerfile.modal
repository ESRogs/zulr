FROM debian:bookworm-slim

# mngr required packages + zuler dependencies + Claude Code tooling
RUN apt-get update -qq && apt-get install -y -qq --no-install-recommends \
    openssh-server tmux curl rsync git ca-certificates \
    unzip nodejs npm \
    ripgrep fd-find jq xxd \
    && rm -rf /var/lib/apt/lists/*

# GitHub CLI (installed via GitHub's apt repo)
RUN mkdir -p -m 755 /etc/apt/keyrings \
    && curl -fsSL https://cli.github.com/packages/githubcli-archive-keyring.gpg \
       | tee /etc/apt/keyrings/githubcli-archive-keyring.gpg > /dev/null \
    && chmod go+r /etc/apt/keyrings/githubcli-archive-keyring.gpg \
    && echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/githubcli-archive-keyring.gpg] https://cli.github.com/packages stable main" \
       | tee /etc/apt/sources.list.d/github-cli.list > /dev/null \
    && apt-get update -qq && apt-get install -y -qq gh \
    && rm -rf /var/lib/apt/lists/*

# ttyd (web-based terminal for mngr connect --web)
RUN ARCH=$(uname -m) && \
    curl -fsSL "https://github.com/tsl0922/ttyd/releases/download/1.7.7/ttyd.${ARCH}" \
    -o /usr/local/bin/ttyd && \
    chmod +x /usr/local/bin/ttyd

# bun
RUN curl -fsSL https://bun.sh/install | bash
ENV BUN_INSTALL="/root/.bun"
ENV PATH="$BUN_INSTALL/bin:$PATH"

# Claude Code
RUN curl -fsSL https://claude.ai/install.sh | bash && test -x /root/.local/bin/claude
ENV PATH="/root/.local/bin:$PATH"
