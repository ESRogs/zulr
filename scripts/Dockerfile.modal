FROM oven/bun:1.3-debian

# Install system dependencies.
# mngr requires: ca-certificates, openssh-server, tmux, curl, rsync, git, jq, xxd
# Claude Code requires: nodejs, npm
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    curl \
    git \
    jq \
    nodejs \
    npm \
    openssh-server \
    rsync \
    tmux \
    xxd \
  && mkdir -p /run/sshd \
  && rm -rf /var/lib/apt/lists/*

# Install Claude Code globally (uses npm since Claude Code is a Node.js package)
ARG CLAUDE_CODE_VERSION=latest
RUN npm install -g @anthropic-ai/claude-code@${CLAUDE_CODE_VERSION}

WORKDIR /root/project
