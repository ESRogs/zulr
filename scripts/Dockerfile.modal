FROM debian:bookworm-slim

# mngr required packages + zuler dependencies (nodejs/npm for Claude Code, unzip for bun)
RUN apt-get update -qq && apt-get install -y -qq --no-install-recommends \
    openssh-server tmux curl rsync git ca-certificates \
    unzip nodejs npm \
    && rm -rf /var/lib/apt/lists/*

# bun (installs to ~/.bun/bin)
RUN curl -fsSL https://bun.sh/install | bash
ENV BUN_INSTALL="/root/.bun"
ENV PATH="$BUN_INSTALL/bin:/usr/local/bin:$PATH"

# Claude Code
RUN npm install -g @anthropic-ai/claude-code

# Skip first-run wizard (theme picker, login dialog, onboarding)
RUN printf '{"hasCompletedOnboarding":true,"numStartups":1}' > /root/.claude.json
